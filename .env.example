# Copy to .env.local and fill in values. NEVER commit .env.local.

# --- Supabase (used by the middleware + board prototype) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- The Pack (/the-pack, multiplayer) ---
# No new env vars -- Realtime and Anonymous Auth both ride on the Supabase
# vars above. One manual dashboard step is required instead: Authentication
# -> Sign In / Providers -> Anonymous Sign-Ins must be toggled ON, or
# signInAnonymously() fails outright.

# --- NBA Standings Pool (/sports/nba-standings) ---
# Required by the 2026-27 standings freeze job (service role key stays server-only).
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
# Password players must enter to unlock a board for editing.
NBA_STANDINGS_PASSCODE=gradeydick

# --- Seattle Sports Dashboard backend ---
# The sports providers used today (MLB Stats API, ESPN public API, PWHL
# HockeyTech feed) are all keyless — no environment variables required.
#
# Future providers that DO need keys (e.g. a paid MLR feed to replace the
# graceful error state in lib/backend/providers/mlr.ts) should be added
# here as placeholders, e.g.:
#   MLR_API_KEY=
#   MLR_API_BASE=
