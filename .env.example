# Copy to .env.local and fill in values. NEVER commit .env.local.

# --- Supabase (used by the middleware + board prototype) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Seattle Sports Dashboard backend ---
# The sports providers used today (MLB Stats API, ESPN public API, PWHL
# HockeyTech feed) are all keyless — no environment variables required.
#
# Future providers that DO need keys (e.g. a paid MLR feed to replace the
# graceful error state in lib/backend/providers/mlr.ts) should be added
# here as placeholders, e.g.:
#   MLR_API_KEY=
#   MLR_API_BASE=
